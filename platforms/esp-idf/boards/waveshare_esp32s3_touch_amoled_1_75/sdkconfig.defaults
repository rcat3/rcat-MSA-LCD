# Waveshare ESP32-S3-Touch-AMOLED-1.75: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/waveshare_esp32s3_touch_amoled_1_75/partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The USB-C port is the ESP32-S3's built-in USB serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Internal RAM is tight: the display's DMA buffers, the task stacks and WiFi
# all need it. Put allocations of 4 KB and more (most of LVGL's) in PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# WiFi (the voice lab) only streams a little audio, so it's set up for
# memory rather than speed: buffers in PSRAM where possible, fewer fixed
# ones in internal RAM, and its code in flash rather than internal RAM
# (which shares space with data on the ESP32-S3).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# SD card: long file names, so images keep their names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Bluetooth LE (the Lovense feature): NimBLE as a central only, with up to
# three connections (RCAT_HAL_BLE_MAX_LINKS), no pairing, and its memory in
# PSRAM. It only starts when it's first used. The controller sets aside room
# for its activities when it starts, so the three links and the scan don't
# take more internal RAM as they're used.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# WiFi and Bluetooth together (the Lovense phone remote) need more internal
# RAM than is left, so some code that would sit in internal RAM runs from
# flash instead: the Bluetooth controller (about 20 KB), and parts of
# FreeRTOS and the heap. The controller pauses while the flash is written
# (when settings are saved), which a connection rides out.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
